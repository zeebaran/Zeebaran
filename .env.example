# Set this to the public origin for canonical links and sitemap URLs.
# NEXT_PUBLIC_SITE_URL=https://www.zeebaran.com
# Optional. Set at build time to enable Google Analytics.
NEXT_PUBLIC_GA_ID=
# Production enquiries use Firestore. Supply ADC or these server-only variables.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional for a local Firestore emulator.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_BUCKET=
# Running a local production build without Firebase: opt into the private local inbox.
# ZEEBARAN_LOCAL_INBOX=1

# Optional verified nursery WhatsApp number (international digits). Otherwise uses the enquiry form.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Required for live PDF intake: your private scanner (raw PDF POST; JSON verdict clean/infected).
PDF_SCAN_URL=
PDF_SCAN_TOKEN=
# Only on a non-Vercel host: header overwritten with a single verified IP by your trusted ingress.
TRUSTED_CLIENT_IP_HEADER=
