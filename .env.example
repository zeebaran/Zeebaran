# Canonical production URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://zeebaran.com
# Server-only form delivery. All four are required to enable direct submission.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=contact@zeebaran.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional public integrations. Never put secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
# Confirm the business pin first; use a https://www.google.com/maps/embed URL.
GOOGLE_MAPS_EMBED_URL=
