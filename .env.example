# Optional canonical origin override. Defaults to Vercel's stable production URL,
# or https://zeebaran.vercel.app outside Vercel. Set a custom domain after DNS cutover.
# NEXT_PUBLIC_SITE_URL=https://zeebaran.vercel.app
# Optional. Set at build time to enable Google Analytics.
NEXT_PUBLIC_GA_ID=
# Web3Forms Free contact delivery. This public form key is expected in the browser.
# Set before building. When configured, both contact forms bypass Firebase enquiry storage.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
# Firebase powers the admin/CMS/catalog and legacy enquiry fallback when Web3Forms is unset.
# Supply ADC or these server-only variables.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Admin sign-in: register a Web app in Firebase project zeebaran085.
# Public Firebase app identifiers, not service-account credentials. Set before building.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-only authorization; verified Firebase emails only.
ADMIN_EMAILS=zeebaran00@gmail.com
# Cloudinary media. Keep the API secret server-only.
CLOUDINARY_CLOUD_NAME=jfiuaflr
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional for a local Firestore emulator.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_BUCKET=
# Running a local production build without Firebase: opt into the private local inbox.
# ZEEBARAN_LOCAL_INBOX=1

# Optional verified nursery WhatsApp number (international digits). Otherwise uses the enquiry form.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Required for live PDF intake: your private scanner (raw PDF POST; JSON verdict clean/infected).
PDF_SCAN_URL=
PDF_SCAN_TOKEN=
# Only on a non-Vercel host: header overwritten with a single verified IP by your trusted ingress.
TRUSTED_CLIENT_IP_HEADER=
